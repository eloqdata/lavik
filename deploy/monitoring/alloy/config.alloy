// Diagnostics use a dedicated rotating JSONL file, separate from worker logs.
local.file_match "lavik" {
  path_targets = [{"__path__" = "/var/log/lavik/latency-diagnostics.log", "service_name" = "lavik-diagnostics"}]
}
loki.source.file "lavik" {
  targets    = local.file_match.lavik.targets
  forward_to = [loki.process.diagnostics.receiver]
}
loki.process "diagnostics" {
  stage.json { expressions = { timestamp = "timestamp_unix_ns" } }
  stage.timestamp {
    source = "timestamp"
    format = "UnixNs"
  }
  forward_to = [loki.write.local.receiver]
}
loki.write "local" {
  endpoint { url = "http://loki:3100/loki/api/v1/push" }
}

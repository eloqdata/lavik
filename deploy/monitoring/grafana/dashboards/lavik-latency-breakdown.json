  "timezone": "browser",
  "uid": "lavik-latency-breakdown",
  "title": "Lavik Latency Breakdown",
  "tags": ["lavik", "latency"],
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(up{job=\"lavik\"}, instance)",
        "hide": 0,
        "includeAll": true,
        "label": "Lavik instance",
        "multi": true,
        "name": "instance",
        "options": [],
        "query": {
          "query": "label_values(up{job=\"lavik\"}, instance)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "links": [
    {
      "title": "Runtime diagnostics runbook",
      "url": "https://github.com/eloqdata/lavik/blob/main/docs/operations/metrics.md#online-latency-diagnostics",
      "targetBlank": true
    },
    {
      "title": "Individual slow traces (optional Loki)",
      "url": "/d/lavik-latency-traces",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Measurement boundaries",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Always-on command latency ends at reply construction. Online GET/SET traces start when a complete command enters the ready queue and end when the server socket write completes; this is **not client RTT**. Diagnostic histograms contain only selected commands exceeding the configured server-total threshold. Stages overlap: **never sum stage percentiles**. Pipelined commands share a batch send span. Runtime diagnostics auto-expire; N=1 selects every eligible command, with explicit capacity/output drops. No EXEC/Lua child or background flush is attributed as an independent command trace."
      }
    },
    {
      "id": 2,
      "title": "Ready request queue",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "lavik_request_queue_length{job=\"lavik\",instance=~\"$instance\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "Socket writes in flight",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "lavik_response_writes_inflight{job=\"lavik\",instance=~\"$instance\"}",
          "legendFormat": "{{instance}}"

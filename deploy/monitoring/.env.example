# Comma-separated Lavik /metrics endpoints as seen from Prometheus.
# Use private IPs or DNS names. For Lavik on this Docker host,
# host.docker.internal:9100 also works.
LAVIK_TARGETS=192.0.2.10:9100
# Multiple nodes example:
# LAVIK_TARGETS=10.0.0.11:9100,10.0.0.12:9100,10.0.0.13:9100

# Browser URL: http://<monitoring-host>:<GRAFANA_PORT>
GRAFANA_BIND_ADDRESS=0.0.0.0
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Prometheus is exposed only on the monitoring host by default, for debugging.
PROMETHEUS_BIND_ADDRESS=127.0.0.1
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d

# Pin images so deployments are reproducible. Upgrade these deliberately.
PROMETHEUS_IMAGE=prom/prometheus:v3.11.3
GRAFANA_IMAGE=grafana/grafana:13.1.0
BUSYBOX_IMAGE=busybox:1.37.0

# Target group metadata. Meta-managed Single and Cluster both use meta-managed.
LAVIK_CLUSTER=default
LAVIK_MODE=standalone
# Optional host path to a complete, user-owned Prometheus file-SD JSON file.
# When set, LAVIK_TARGETS is ignored; see prometheus/targets.example.json.
# LAVIK_TARGETS_FILE=./my-targets.json

# URL reachable by notification readers, not a container-only hostname.
GRAFANA_PUBLIC_URL=http://localhost:3000

# Empty means rule evaluation only. For the local alertmanager profile use
# alertmanager:9093; for an existing service use its reachable host:port.
ALERTMANAGER_TARGETS=
ALERTMANAGER_IMAGE=prom/alertmanager:v0.34.1
ALERTMANAGER_BIND_ADDRESS=127.0.0.1
ALERTMANAGER_PORT=9093
# Optional host path to your Alertmanager configuration.
# ALERTMANAGER_CONFIG=./my-alertmanager.yml

+#ifndef SSL_LIBRARY_NOT_FOUND
+std::vector<std::string> peer_uri_sans(ssl_socket& socket) {
+    std::vector<std::string> result;
+    X509* cert = SSL_get1_peer_certificate(socket.native_handle());
+    if (!cert) return result;
+    GENERAL_NAMES* names = static_cast<GENERAL_NAMES*>(
+        X509_get_ext_d2i(cert, NID_subject_alt_name, nullptr, nullptr));
+    if (names) {
+        const int count = sk_GENERAL_NAME_num(names);
+        for (int ii = 0; ii < count; ++ii) {
+            const GENERAL_NAME* name = sk_GENERAL_NAME_value(names, ii);
+            if (!name || name->type != GEN_URI) continue;
+            const ASN1_IA5STRING* uri = name->d.uniformResourceIdentifier;
+            const unsigned char* data = ASN1_STRING_get0_data(uri);
+            const int len = ASN1_STRING_length(uri);
+            if (data && len >= 0) {
+                result.emplace_back(reinterpret_cast<const char*>(data),
+                                    static_cast<size_t>(len));
+            }
+        }
+        GENERAL_NAMES_free(names);
+    }
+    X509_free(cert);
+    return result;
+}
+#else
+std::vector<std::string> peer_uri_sans(ssl_socket&) {
+    return std::vector<std::string>();
+}
+#endif

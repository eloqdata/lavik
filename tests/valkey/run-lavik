set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)
LAVIK_BIN=${LAVIK_BIN:-$REPO_ROOT/build/lavik}
LAVIK_HOST=${LAVIK_HOST:-127.0.0.1}
LAVIK_PORT=${LAVIK_PORT:-16379}
DATA_FILE=$(mktemp \
  "${LAVIK_TEST_DATA_DIR:-/tmp}/lavik-valkey.XXXXXX.data")
LOG_FILE=$(mktemp \
  "${LAVIK_TEST_DATA_DIR:-/tmp}/lavik-valkey.XXXXXX.log")
SERVER_PID=

cleanup() {
    status=$?
    trap - EXIT INT TERM
    if [ -n "$SERVER_PID" ]; then
        kill "$SERVER_PID" 2>/dev/null || true
        attempts=0
        while kill -0 "$SERVER_PID" 2>/dev/null && [ "$attempts" -lt 100 ]; do
            attempts=$((attempts + 1))
            sleep 0.1
        done
        if kill -0 "$SERVER_PID" 2>/dev/null; then
            kill -KILL "$SERVER_PID" 2>/dev/null || true
        fi
        wait "$SERVER_PID" 2>/dev/null || true
    fi
    rm -f "$DATA_FILE" "$LOG_FILE"
    exit "$status"
}
trap cleanup EXIT INT TERM

if [ ! -x "$LAVIK_BIN" ]; then
    echo "Lavik binary is not executable: $LAVIK_BIN" >&2
    exit 1
fi

truncate -s "${LAVIK_TEST_DATA_SIZE:-8G}" "$DATA_FILE"
"$LAVIK_BIN" \
    --logtostderr \
    --bind "$LAVIK_HOST" \
    --port "$LAVIK_PORT" \
    --threads "${LAVIK_TEST_THREADS:-2}" \
    --no-pin-workers \
    --recv-buffers-per-worker "${LAVIK_TEST_RECV_BUFFERS:-0}" \
    --registered-buffer-mb-per-worker "${LAVIK_TEST_BUFFER_MB:-64}" \
    --replication-publish-queue-mb-per-worker "${LAVIK_TEST_REPLICATION_QUEUE_MB:-8}" \
    --max-memory "${LAVIK_TEST_MAX_MEMORY:-2147483648}" \
    --data-file "$DATA_FILE" >"$LOG_FILE" 2>&1 &
SERVER_PID=$!

ready=0
attempt=0
while [ "$attempt" -lt 300 ]; do
    if ! kill -0 "$SERVER_PID" 2>/dev/null; then
        echo "Lavik exited before becoming ready:" >&2
        sed -n '1,240p' "$LOG_FILE" >&2
        exit 1
    fi
    if redis-cli -h "$LAVIK_HOST" -p "$LAVIK_PORT" PING 2>/dev/null \
        | grep -qx PONG; then
        ready=1
        break
    fi
    attempt=$((attempt + 1))
    sleep 0.1
done

if [ "$ready" -ne 1 ]; then
    echo "Timed out waiting for Lavik on $LAVIK_HOST:$LAVIK_PORT" >&2
    sed -n '1,240p' "$LOG_FILE" >&2
    exit 1
fi

LAVIK_HOST=$LAVIK_HOST LAVIK_PORT=$LAVIK_PORT \
    "$SCRIPT_DIR/runtest" "$@"

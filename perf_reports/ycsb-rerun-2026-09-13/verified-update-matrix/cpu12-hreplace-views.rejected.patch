+absl::StatusOr<std::size_t> PrepareReplacementHash(
+    const HashOperation& operation, HashValue& value,
+    std::optional<std::string>& compact_payload) {
+  // Sort request positions, not owned values: duplicate fields use the last
+  // argument in O(n log n), without loading the old Hash. Inline scratch avoids
+  // an allocation for small replacements; larger requests use the same sort.
+  // Only owned bytes leave this synchronous helper. Its scratch and borrowed
+  // views are dead before the caller awaits publication or another lock.
+  absl::InlinedVector<std::size_t, 16> order(operation.fields_.size());
+  for (std::size_t i = 0; i < order.size(); ++i) order[i] = i;
+  std::sort(order.begin(), order.end(), [&](auto a, auto b) {
+    return operation.fields_[a] == operation.fields_[b]
+               ? a < b
+               : operation.fields_[a] < operation.fields_[b];
+  });
+  absl::InlinedVector<HashEntryView, 16> entries;
+  entries.reserve(order.size());
+  std::uint64_t bytes = kHashValueHeaderBytes;
+  for (std::size_t i = 0; i < order.size(); ++i) {
+    const auto position = order[i];
+    const auto field = operation.fields_[position];
+    if (i + 1 < order.size() && field == operation.fields_[order[i + 1]])
+      continue;
+    const auto field_value = operation.values_[position];
+    entries.push_back({field, field_value});
+    // This is the same promotion decision as NeedsGroupedHash, applied after
+    // duplicate elimination. Individual sizes were checked before admission;
+    // stop accumulating at the threshold so large collections cannot overflow.
+    if (bytes < kGroupedHashPromotionBytes)
+      bytes += 8 + field.size() + field_value.size();
+  }
+  if (bytes < kGroupedHashPromotionBytes) {
+    auto encoded = EncodeHashEntryViews(entries);
+    if (!encoded.ok()) return encoded.status();
+    compact_payload.emplace(std::move(*encoded));
+    return entries.size();
+  }
+
+  // Group planning still consumes owned entries. Compact replacements instead
+  // copy request bytes only into their final payload, avoiding per-field heap
+  // strings and unused process-local digests; the durable encoding is identical.
+  value.entries_.reserve(entries.size());
+  for (const auto& view : entries) {
+    // Construct in the reserved slot to avoid moving temporary SSO strings.
+    // The caller owns this unpublished value and discards it on allocation
+    // failure, so a partially initialized entry cannot reach the live index.
+    auto& entry = value.entries_.emplace_back();
+    entry.digest_ = ComputeDigest(view.field_);
+    entry.field_.assign(view.field_);
+    entry.value_.assign(view.value_);
+  }
+  return entries.size();
+}
